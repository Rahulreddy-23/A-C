ADO_BASE_URL=http://localhost:8089/kestrel-org
ADO_PROJECT=Kestrel
APP_ADO_PAT=mock-app-token
SEED_ADO_PAT=mock-seed-token
ADO_DOCS_REPO=kestrel-dhf-docs
ADO_DEVICE_REPO=kestrel-device-sw
ADO_REQUIRED_REVIEWERS=mock-reviewer
# auto: real organizations are read-only (GET + WIQL/batch reads only); localhost mock may write its docs repo.
ADO_READ_ONLY=auto
# Real projects: point at a scope YAML (see specs/ado_scope.example.yaml) and a reviewed mapping profile.
ADO_SCOPE=
ADO_MAPPING=specs/ado_mapping.yaml
ADO_MAX_ITEMS=5000
DHF_PROVIDER=mock
# Explorer labels for real evidence (defaults describe the synthetic Kestrel demo).
DHF_PRODUCT_NAME=Kestrel
DHF_PRODUCT_SUBJECT=Infusion Controller
DHF_RELEASE=1.1
DHF_MODEL_MOCK=mock-v2
DHF_MODEL_ANTHROPIC=claude-haiku-5-5
DHF_MODEL_OPENAI=gpt-4.1-mini
DHF_MODEL_OPENAI_ANALYTICAL=gpt-5.4-mini
DHF_OPENAI_REASONING_EFFORT=low
DHF_OPENAI_REASONING_TOKENS=4000
DHF_MAX_USD_PER_RUN=0.25
DHF_BUILD_BUDGET_USD=1.50
DHF_PROVIDER_BUDGET_USD=4.00
DHF_HARD_CAP_USD_ANTHROPIC=2.50
DHF_HARD_CAP_USD_OPENAI=4.00
# BD-approved tenant only; set a real flow URL or synced folder in ignored .env.
DHF_COPILOT_MODE=http
# reported: require counts; estimated: fall back when counts are unavailable.
DHF_COPILOT_USAGE=reported
DHF_COPILOT_FLOW_URL=
DHF_COPILOT_EXCHANGE_DIR=
DHF_MODEL_COPILOTSTUDIO=bd-basic-gpt
DHF_COPILOT_CREDIT_CAP=400
DHF_COPILOT_CREDITS_PER_RUN=250
DHF_COPILOT_CREDITS_PER_1K=0.1
DHF_COPILOT_TIMEOUT_S=120
DHF_ANTHROPIC_INPUT_PER_MILLION=0.10
DHF_ANTHROPIC_OUTPUT_PER_MILLION=0.50
DHF_OPENAI_INPUT_PER_MILLION=0.40
DHF_OPENAI_OUTPUT_PER_MILLION=1.60
